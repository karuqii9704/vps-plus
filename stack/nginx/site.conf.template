# Rendered by install/80-nginx.sh, once per app with a domain in vps.conf.
# Placeholders are substituted with envsubst; do not add shell syntax here.
#
#   __DOMAIN__      primary hostname
#   __ALT_SERVER__  optional apex redirect block (empty for most apps)
#   __PORT__        loopback port the container publishes
#   __APP__         app key, used in the log filename
#
# TLS is not configured here. Certbot's --nginx installer adds the listen 443
# block, the certificate paths and the http->https redirect to this file after
# it issues a certificate, which keeps renewal working without hand-editing.

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    access_log /var/log/nginx/__APP__.access.log;
    error_log  /var/log/nginx/__APP__.error.log;

    # Certbot writes its HTTP-01 challenge here. It must be reachable over
    # plain HTTP even after the redirect below exists, so it comes first.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    # Uploads and AI responses (Gemini returns base64 image data) are large.
    client_max_body_size 10m;

    # An AI generation call can legitimately take a minute; the default 60s
    # read timeout would cut it off and show a 504.
    proxy_read_timeout    180s;
    proxy_send_timeout    180s;
    proxy_connect_timeout 10s;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json
               application/xml image/svg+xml font/woff2;

    # Set once here rather than per-location, so a new location block cannot
    # forget them and break client-IP logging or rate limiting.
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;

    location / {
        proxy_pass http://127.0.0.1:__PORT__;
    }

    # Next.js fingerprints these filenames, so they can be cached forever.
    location /_next/static/ {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_cache_valid 200 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
}

__ALT_SERVER__

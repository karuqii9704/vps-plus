# msmtp — email relay OJS container (Fase 10c).
# Host sebelumnya TIDAK punya /usr/sbin/sendmail sama sekali (email OJS mati
# diam-diam). Sekarang sendmail = msmtp; tanpa MSMTP_HOST berarti mode
# log-only (email tercatat di docker logs, tidak dikirim).
# Set MSMTP_HOST/MSMTP_PORT saat relay SMTP tersedia, lalu tulis ulang config
# ini (entrypoint/prompt) atau bind-mount msmtprc baru.
defaults
auth           off
tls            off
syslog         off

account        default
host           localhost
port           25
from           ojs@testojs.plusthe.site
logfile        /proc/self/fd/2

# plus. marketing site — runtime environment (docker compose env_file).
#
# NEXT_PUBLIC_* values here are ALSO needed at build time. install/70-apps.sh
# reads them out of this file and passes them to `docker compose build` as
# build args, so you only maintain one copy.
#
# Restored automatically from the Windows bundle as stack/apps/plus.env.

# --- server only (read at request time; never in the browser bundle) --------
GEMINI_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- public (inlined into the browser bundle at build time) -----------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_STUDIO_URL=https://studio.plusthe.site
# "on" needs a commercial licence for the shaders package — leave off.
NEXT_PUBLIC_HERO_SHADER=off

# --- local postgres (optional; the app also runs entirely on Supabase) ------
# `postgres` is the compose service name, reachable on the vpsplus network.
DATABASE_URL=postgres://vpsplus:CHANGEME@postgres:5432/plusthesite

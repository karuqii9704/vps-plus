# NALAR — runtime environment.
#
# The app degrades gracefully when a value is missing: no Supabase means seed
# data only, no GEMINI_API_KEY means the deterministic chatbot fallback, no
# maps key means the SVG scatter map. Nothing here is strictly required to boot.

# --- supabase (live POS + reviews layer) ------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- committee postgres (/nasional) -----------------------------------------
# Points at the container on the vpsplus network. Load the committee dump with:
#   ops/psql.sh nalar < dump.sql
HACK_DB_HOST=postgres
HACK_DB_PORT=5432
HACK_DB_NAME=nalar
HACK_DB_USER=vpsplus
HACK_DB_PASSWORD=CHANGEME
# Local container traffic never leaves the host, so SSL is off here.
HACK_DB_SSL=0

# --- optional ---------------------------------------------------------------
GEMINI_API_KEY=
NEXT_PUBLIC_MAPS_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

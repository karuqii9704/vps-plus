# PLUS Studio — runtime environment.
#
# VITE_* is inlined into the SPA bundle at build time; changing one needs a
# rebuild, not a restart. GEMINI_API_KEY is server-only and read per request,
# which is the whole reason the SPA calls same-origin /api/ai.

# --- public (build time) ----------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_MAIN_SITE_URL=https://www.plusthe.site

# --- server only (run time) -------------------------------------------------
GEMINI_API_KEY=
PORT=8787
# Same-origin needs no CORS; set this only for a split deploy.
ALLOWED_ORIGINS=https://studio.plusthe.site

# Trilux — runtime environment for the Express host in apps/trilux/server.js.
#
# api/lead.js and api/track.js still write to Vercel Blob. That works from any
# host, but it means the site is not fully off Vercel. See
# docs/MIGRATION-NOTES.md before deciding whether to move that to Postgres.

ADMIN_TOKEN=
BLOB_READ_WRITE_TOKEN=

SITE_ROOT=/site
PORT=8080
